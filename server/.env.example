# ==================== LLM 配置 ====================
# OpenAI 兼容接口, 可对接: OpenAI / 通义千问 / 豆包 / DeepSeek / GLM 等
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1

# 多模态视觉模型 (食材识别, 需支持图片输入), 如: gpt-4o-mini / qwen-vl-max
VISION_MODEL=gpt-4o-mini

# 对话模型 (交互回复 / 创意建议), 如: gpt-4o-mini / qwen-plus
CHAT_MODEL=gpt-4o-mini

# 模型温度
LLM_TEMPERATURE=0.3

# ==================== 联网搜索 (Tavily) ====================
# 食谱联网搜索使用, 获取地址: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000

# 上传图片大小上限 (MB)
MAX_IMAGE_SIZE_MB=8
